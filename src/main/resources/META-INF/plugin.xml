<idea-plugin>
    <id>com.neko233.jenkinsfile</id>
    <name>Jenkinsfile Studio</name>
    <vendor url="https://github.com/neko233-com">neko233-com</vendor>
    <url>https://github.com/neko233-com/Jenkinsfile-jetbrains-plugin</url>
    <description><![CDATA[
        <p>Free Jenkinsfile editor for GoLand and IntelliJ-based IDEs.</p>
        <p>Includes Groovy and Jenkins Pipeline syntax highlighting, grammar checks, context-aware completion, named-field highlighting, an outline in the Structure view, Jenkins GDSL import, and idempotent formatting.</p>
        <p>Formats with <code>Ctrl+Shift+L</code> (or the IDE Reformat Code action). Formatting preserves statement line breaks and can be repeated safely.</p>
        <p>The plugin works offline and does not collect or upload source code. Source and license: <a href="https://github.com/neko233-com/Jenkinsfile-jetbrains-plugin">GitHub</a>.</p>
    ]]></description>
    <change-notes><![CDATA[<ul><li>Highlight Jenkins named argument keys and add a Pipeline Structure view.</li><li>Make spacing and indentation formatting repeatable and stable.</li><li>Provide a Marketplace-ready plugin logo and metadata.</li></ul>]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Jenkinsfile"
                  implementationClass="com.neko233.jenkinsfile.language.JenkinsfileFileType"
                  fieldName="INSTANCE"
                  language="Jenkinsfile"
                  fileNames="Jenkinsfile"
                  patterns="Jenkinsfile*"
                  extensions="jenkinsfile"/>
        <lang.parserDefinition language="Jenkinsfile"
                               implementationClass="com.neko233.jenkinsfile.language.JenkinsfileParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Jenkinsfile"
                                       implementationClass="com.neko233.jenkinsfile.language.JenkinsfileSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="Jenkinsfile"
                           implementationClass="com.neko233.jenkinsfile.language.JenkinsfileBraceMatcher"/>
        <lang.formatter language="Jenkinsfile"
                        implementationClass="com.neko233.jenkinsfile.format.JenkinsfileFormattingModelBuilder"/>
        <lang.psiStructureViewFactory language="Jenkinsfile"
                                      implementationClass="com.neko233.jenkinsfile.structure.JenkinsfileStructureViewFactory"/>
        <annotator language="Jenkinsfile"
                   implementationClass="com.neko233.jenkinsfile.inspection.JenkinsfileSyntaxAnnotator"/>
        <completion.contributor language="Jenkinsfile"
                                implementationClass="com.neko233.jenkinsfile.completion.JenkinsfileCompletionContributor"/>
    </extensions>

    <actions>
        <action id="Jenkinsfile.ImportGdsl"
                class="com.neko233.jenkinsfile.actions.ImportJenkinsGdslAction"
                text="Import Jenkins Pipeline GDSL…"
                description="Import the Pipeline DSL generated by a Jenkins controller">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Jenkinsfile.Reformat"
                class="com.neko233.jenkinsfile.actions.JenkinsfileFormatAction"
                text="Reformat Jenkinsfile"
                description="Format the current Jenkinsfile">
            <keyboard-shortcut first-keystroke="ctrl shift L" keymap="$default"/>
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
